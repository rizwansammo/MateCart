# MateCart local development environment (Docker Compose project "matecart-dev").
#
# Create your local .env with:   pnpm setup:env
# That copies this file and replaces every __GENERATE__ value with a random local secret.
# Never commit .env. These values are for local development only, never for any real deployment.

# --- Host ports (published on 127.0.0.1 only) ---
# Chosen to avoid other local projects and Windows/Hyper-V reserved port ranges.
# Change them here if a port is taken; the Next.js dev ports live in apps/*/package.json.
MATECART_COMMERCE_API_PORT=8400
MATECART_CONTROL_API_PORT=8410
MATECART_COMMERCE_DB_PORT=15440
MATECART_CONTROL_DB_PORT=15441
MATECART_COMMERCE_REDIS_PORT=16380

# --- Tenancy ---
# The store this local commerce deployment serves (a UUID; generated). `pnpm api:provision`
# creates it in the database. In production the Central Console issues this id.
MATECART_TENANT_ID=__GENERATE_UUID__

# --- Local-only credentials (generated) ---
MATECART_COMMERCE_DB_PASSWORD=__GENERATE__
MATECART_CONTROL_DB_PASSWORD=__GENERATE__
MATECART_COMMERCE_REDIS_PASSWORD=__GENERATE__
MATECART_COMMERCE_SECRET_KEY=__GENERATE__
MATECART_CONTROL_SECRET_KEY=__GENERATE__
