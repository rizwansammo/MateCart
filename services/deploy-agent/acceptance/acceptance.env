MATECART_STORE_ALIAS=acc-template
MATECART_COMMERCE_API_IMAGE=matecart-dev/commerce-api:acceptance-1
MATECART_COMMERCE_WEB_IMAGE=matecart-dev/commerce-web:acceptance-1
