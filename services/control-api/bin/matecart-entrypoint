#!/bin/sh
# MateCart control-api production entrypoint (D-117). Fixed roles only.
#
#   api      gunicorn WSGI server (the Control API has no WebSocket routes)
#   worker   Celery worker (monitoring evaluation, deployment reconciliation, retention)
#   beat     Celery beat (exactly one per Console deployment)
#   migrate  one-shot: checks and migrations
set -eu

role="${1:-api}"

case "$role" in
  api)
    exec gunicorn config.wsgi:application \
      --bind 0.0.0.0:8000 \
      --workers "${MATECART_API_WORKERS:-2}" \
      --threads "${MATECART_API_THREADS:-4}" \
      --worker-tmp-dir /tmp \
      --timeout 60 --graceful-timeout 25 --keep-alive 10 \
      --max-requests 2000 --max-requests-jitter 200 \
      --limit-request-line 8190 --forwarded-allow-ips "${MATECART_FORWARDED_ALLOW_IPS:-127.0.0.1}"
    ;;
  worker)
    exec celery -A config worker --loglevel=INFO \
      --concurrency="${MATECART_WORKER_CONCURRENCY:-2}" --hostname="control-worker@%h"
    ;;
  beat)
    exec celery -A config beat --loglevel=INFO --schedule=/tmp/celerybeat-schedule
    ;;
  migrate)
    python manage.py check
    exec python manage.py migrate --noinput
    ;;
  check)
    exec python manage.py check --deploy --fail-level ERROR
    ;;
  *)
    echo "matecart-entrypoint: unknown role '$role' (api, worker, beat, migrate, check)" >&2
    exit 64
    ;;
esac
