# commerce-web local settings. `pnpm setup:env` copies this file to .env.local (never committed).

# Server-only: how the Next.js server reaches commerce-api. Never exposed to the browser.
COMMERCE_API_INTERNAL_URL=http://127.0.0.1:8400

# Storefront (Phase 06). All server-only and optional.
# Search engines may index the store only when this is exactly "allow" (production stores).
STOREFRONT_INDEXING=
# Public origin used for absolute links in sharing metadata, e.g. https://shop.example.com.
STOREFRONT_PUBLIC_URL=
# Development only (ignored by production builds): preview another preset without changing
# the store, e.g. STOREFRONT_PREVIEW_PRESET=books pnpm dev:web. One of fashion, grocery,
# electronics, general, books.
STOREFRONT_PREVIEW_PRESET=
